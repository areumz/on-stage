# Supabase 프로젝트 URL — 서버 전용
SUPABASE_URL=
# 사용자 세션 기반 접근 — 서버 전용 (NEXT_PUBLIC_ 접두사를 쓰지 않는다, §4.7 제약 4번)
SUPABASE_ANON_KEY=
# 시드 스크립트 전용 — 서버 전용, Vercel에는 등록하지 않는다
SUPABASE_SERVICE_ROLE_KEY=
# 오너 계정 생성용 — 로컬 전용
SEED_OWNER_EMAIL=
# 오너 계정 생성용 — 로컬 전용
SEED_OWNER_PASSWORD=
# Python 서비스(stage-director-agent) 주소 — 서버 전용
PYTHON_SERVICE_URL=
# Python 서비스 인증 키(X-Internal-Key) — 서버 전용, 브라우저로 내보내지 않는다 (NEXT_PUBLIC_ 금지)
INTERNAL_API_KEY=
# 서비스 전체 하루 "연출 만들기" 한도. 비우면 5. 다시 생성·데모 곡은 세지 않는다
DAILY_RUN_LIMIT=
# 궤도 화면을 평면(2D 폴백)으로 고정하려면 2d. 비우면 3D. ?orbit=2d 쿼리가 우선한다 — 서버 전용
ORBIT_VIEW=
